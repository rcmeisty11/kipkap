[Unit]
Description=KipKap Badge FastAPI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/kipkapbadge/backend
EnvironmentFile=/home/ubuntu/kipkapbadge/backend/.env
ExecStart=/home/ubuntu/kipkapbadge/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
